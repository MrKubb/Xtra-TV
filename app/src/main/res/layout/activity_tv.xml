<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">


        <LinearLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLive"
                    style="@style/TvButton"
                    android:text="@string/tv_watch_live"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnLanguage"
                    style="@style/TvButton"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:hint="@string/search"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777777"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnSearchStreams"
                    style="@style/TvButton"
                    android:text="@string/streams" />

                <TextView
                    android:id="@+id/btnSearchChannels"
                    style="@style/TvButton"
                    android:text="@string/channels" />

                <TextView
                    android:id="@+id/btnSearchGames"
                    style="@style/TvButton"
                    android:text="@string/games" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- home: one horizontal row per section; bottom padding lets the last rows reach the top -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeRows"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingBottom="320dp" />

                <!-- full screen lists: game, channel, search -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:fadingEdgeLength="24dp"
                    android:paddingVertical="8dp"
                    android:requiresFadingEdge="vertical"
                    android:visibility="gone" />

                <ScrollView
                    android:id="@+id/settingsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fadingEdgeLength="24dp"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/settingsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="24dp" />
                </ScrollView>

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/nothing_here"
                    android:textColor="#9A9AA2"
                    android:textSize="20sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- sidebar: slides over the content when focused, hidden otherwise -->
    <ScrollView
        android:id="@+id/sidebarPanel"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:background="#F218181B"
        android:elevation="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp">

            <TextView
                android:id="@+id/tabSearch"
                style="@style/TvTab"
                android:layout_marginBottom="16dp"
                android:drawablePadding="12dp"
                android:text="@string/search"
                app:drawableStartCompat="@drawable/baseline_search_black_24"
                app:drawableTint="@color/tv_tab_text" />

            <!-- one entry per home section, built from the TV settings -->
            <LinearLayout
                android:id="@+id/sectionTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#2E2E35" />

            <TextView
                android:id="@+id/tabAccount"
                style="@style/TvTab"
                android:text="@string/log_in" />

            <TextView
                android:id="@+id/tabSettings"
                style="@style/TvTab"
                android:text="@string/settings" />
        </LinearLayout>
    </ScrollView>

    <!-- live preview: a floating, larger copy of the focused card, placed over it by TvPreview -->
    <LinearLayout
        android:id="@+id/previewPopup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/tv_preview_popup_bg"
        android:elevation="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:descendantFocusability="blocksDescendants"
            android:focusable="false"
            app:resize_mode="zoom"
            app:shutter_background_color="#1F1F23"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tv_preview_info_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/previewAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/previewLine1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/previewLine2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#EDE4FF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/previewLine3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#DCD0F5"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
