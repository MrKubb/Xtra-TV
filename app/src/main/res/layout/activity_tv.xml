<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E10"
    android:orientation="horizontal">

    <ScrollView
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:background="#18181B"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp">

            <TextView
                android:id="@+id/tabSearch"
                style="@style/TvTab"
                android:layout_marginBottom="16dp"
                android:drawablePadding="12dp"
                android:text="@string/search"
                app:drawableStartCompat="@drawable/baseline_search_black_24"
                app:drawableTint="@color/tv_tab_text" />

            <TextView
                android:id="@+id/tabFollowing"
                style="@style/TvTab"
                android:text="@string/tv_followed_live" />

            <TextView
                android:id="@+id/tabFollowedGames"
                style="@style/TvTab"
                android:text="@string/tv_followed_games" />

            <TextView
                android:id="@+id/tabFollowedVideos"
                style="@style/TvTab"
                android:text="@string/tv_past_broadcasts" />

            <TextView
                android:id="@+id/tabFollowedChannels"
                style="@style/TvTab"
                android:text="@string/tv_followed_channels" />

            <TextView
                android:id="@+id/tabTopGames"
                style="@style/TvTab"
                android:text="@string/tv_top_games" />

            <TextView
                android:id="@+id/tabTopStreams"
                style="@style/TvTab"
                android:text="@string/tv_top_streams" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#2E2E35" />

            <TextView
                android:id="@+id/tabAccount"
                style="@style/TvTab"
                android:text="@string/log_in" />

            <TextView
                android:id="@+id/tabSettings"
                style="@style/TvTab"
                android:text="@string/settings" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLive"
                style="@style/TvButton"
                android:text="@string/tv_watch_live"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnLanguage"
                style="@style/TvButton"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="@string/search"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnSearchStreams"
                style="@style/TvButton"
                android:text="@string/streams" />

            <TextView
                android:id="@+id/btnSearchChannels"
                style="@style/TvButton"
                android:text="@string/channels" />

            <TextView
                android:id="@+id/btnSearchGames"
                style="@style/TvButton"
                android:text="@string/games" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fadingEdgeLength="24dp"
                android:paddingVertical="8dp"
                android:requiresFadingEdge="vertical" />

            <ScrollView
                android:id="@+id/settingsScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fadingEdgeLength="24dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/settingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp" />
            </ScrollView>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/nothing_here"
                android:textColor="#9A9AA2"
                android:textSize="20sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
